---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES } from '../../data/site';
import { CURRENT_TAX_YEAR as YEAR } from '../../data/tax-years';
---

<BaseLayout
  title={`UK Tax Guides ${YEAR.label} | TaxSums`}
  description={`Plain-English guides to UK tax for the ${YEAR.label} tax year: income tax rates, student loan thresholds, salary sacrifice, the £100k trap, stamp duty relief and going limited.`}
  crumbs={[{ label: 'Guides' }]}
>
  <div class="wrap">
    <div class="tool-header">
      <h1>Guides</h1>
      <p class="tool-standfirst">
        The explanations behind the calculators. Each one covers a single question properly and
        links to the tool that works out your own figures.
      </p>
    </div>

    <ul class="card-grid">
      {
        GUIDES.map((guide) => (
          <li>
            <a class="card" href={`/guides/${guide.slug}/`}>
              <strong>{guide.h1}</strong>
              <span>{guide.metaDescription}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
