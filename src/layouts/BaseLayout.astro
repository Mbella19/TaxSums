---
import { SITE, ADS_ENABLED, ADSENSE_CLIENT } from '../config';
import { CATEGORIES, toolsInCategory } from '../data/site';
import { CURRENT_TAX_YEAR } from '../data/tax-years';
import SiteSearch from '../components/SiteSearch.astro';
import AnchorAd from '../components/AnchorAd.astro';
import '../styles/global.css';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks, already shaped. */
  schema?: unknown[];
  crumbs?: Crumb[];
  /** Set on pages that must never be indexed. Nothing uses it by default. */
  noindex?: boolean;
  /**
   * Suppresses every ad unit on the page. Set on the trust pages — /about/,
   * /privacy/, /methodology/ and the like. Someone reading those is deciding
   * whether to believe the numbers, which is the wrong moment to sell them
   * something.
   */
  noAds?: boolean;
}

const {
  title,
  description,
  schema = [],
  crumbs = [],
  noindex = false,
  noAds = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.origin).href;

const breadcrumbSchema =
  crumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.label,
          ...(crumb.href ? { item: new URL(crumb.href, SITE.origin).href } : {}),
        })),
      }
    : null;

const organisationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.origin,
  description: SITE.description,
};

const allSchema = [organisationSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      /*
       * Newsreader is self-hosted and subset, so there is no third-party
       * request and no DNS round-trip before the H1 can paint. Preloading the
       * roman cut — the only one used above the fold — closes the swap window
       * to near zero, which is what keeps CLS at 0 despite `font-display:swap`.
       * The italic is used on guide standfirsts only, so it is not preloaded.
       */
    }
    <link
      rel="preload"
      href="/fonts/newsreader-roman.344c295d.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      allSchema.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }

    {
      /*
       * The script loads on every page, including the ones that carry no ad
       * units. Verification and policy review expect it site-wide, and `noAds`
       * is an editorial decision about where units appear — not a reason to
       * hide the tag from a reviewer reading /about/.
       */
      ADS_ENABLED && ADSENSE_CLIENT && (
        <script is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        {/* Split so the second syllable can take the accent colour. */}
        <a class="brand" href="/">Tax<span>Sums</span></a>
        <span class="year-badge">{CURRENT_TAX_YEAR.label}</span>
        <nav class="site-nav" aria-label="Main">
          {
            CATEGORIES.map((category) => (
              <a href={`/${category.slug}/`}>{category.navTitle}</a>
            ))
          }
          <a href="/guides/">Guides</a>
          <a href="/rates/">Rates</a>
        </nav>
        <SiteSearch />
      </div>
    </header>

    {
      crumbs.length > 0 && (
        <nav class="breadcrumbs wrap" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((crumb) => (
              <li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-cols">
          {
            /*
             * Generated from the tool list, not hand-written. Internal links
             * are how Google discovers pages, and a hand-maintained footer rots
             * the moment a URL changes.
             */
            CATEGORIES.map((category) => (
              <div>
                <h2>{category.navTitle}</h2>
                <ul>
                  {toolsInCategory(category.slug).map((tool) => (
                    <li>
                      <a href={`/${tool.slug}/`}>{tool.shortName}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div>
            <h2>About</h2>
            <ul>
              <li><a href="/about/">About us</a></li>
              <li><a href="/methodology/">Methodology</a></li>
              <li><a href="/rates/">Rates and sources</a></li>
              <li><a href="/changelog/">Rate changelog</a></li>
              <li><a href="/guides/">Guides</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
          </div>
          <div>
            <h2>Legal</h2>
            <ul>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
              <li><a href="/disclaimer/">Disclaimer</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-legal">
          <p>
            <strong>{SITE.name}</strong> gives estimates based on published HMRC, Revenue Scotland
            and Welsh Revenue Authority figures for the {CURRENT_TAX_YEAR.label} tax year. It is
            information, not financial or tax advice, and it cannot account for every personal
            circumstance. Check anything important with an accountant or with HMRC before acting on
            it.
          </p>
          <p>&copy; {new Date().getFullYear()} {SITE.name}. Rates last verified 7 August 2026.</p>
        </div>
      </div>
    </footer>

    {!noAds && <AnchorAd />}
  </body>
</html>
