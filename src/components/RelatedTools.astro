---
import { relatedTools, type Tool } from '../data/site';

interface Props {
  tool: Tool;
  heading?: string;
}

const { tool, heading = 'Related calculators' } = Astro.props;
const related = relatedTools(tool);
---

{
  /*
   * Plain <a href> links with descriptive anchor text. Google discovers pages
   * through links and uses the anchor text to understand them, so these are
   * navigation and ranking signal at once — not decoration.
   */
}
<section aria-labelledby="related-heading">
  <h2 id="related-heading">{heading}</h2>
  <ul class="card-grid">
    {
      related.map((item) => (
        <li>
          <a class="card" href={`/${item.slug}/`}>
            <strong>{item.h1}</strong>
            <span>{item.standfirst}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
