---
import { ADS_ENABLED, ADSENSE_CLIENT, AD_SLOTS } from '../config';

interface Props {
  format: 'leaderboard' | 'rectangle' | 'sidebar';
  /** Overrides the zone's configured slot. Nothing needs this yet. */
  slot?: string;
}

const { format } = Astro.props;
// The zone's own ID unless a caller deliberately overrides it.
const slot = Astro.props.slot ?? AD_SLOTS[format];

// Shown only while ads are switched off, so the reserved space reads as
// deliberate during development rather than as a broken image.
const PLACEHOLDER: Record<Props['format'], string> = {
  leaderboard: '970×250 → 336×280 responsive',
  rectangle: '336×280 in-content',
  sidebar: '300×600 half-page',
};

const live = ADS_ENABLED && ADSENSE_CLIENT && slot;
const preview = !ADS_ENABLED;

/*
 * Between the two — ads on, but this zone has no slot ID yet — nothing renders
 * at all. That is the state the site sits in while AdSense reviews it, and an
 * empty bordered box captioned "970x250 responsive" would look to a reviewer
 * like a site that was never finished.
 */
---

{
  /*
   * The container reserves its height whether or not an ad is served, so
   * enabling AdSense later cannot move content under a reader's finger.
   * Cumulative Layout Shift stays at zero either way.
   *
   * Placement rule followed throughout: never directly above or beside a
   * calculator's result, and never so close to an input that a mistap is
   * plausible. That is both an AdSense policy matter and a usability one.
   *
   * The "Advertisement" label is not decoration. AdSense requires paid units to
   * be distinguishable from content, and on a page full of financial figures it
   * is what stops an advert being read as part of a calculation.
   */
}
{
  (live || preview) && (
    <aside class="ad" aria-label="Advertisement">
      <p class="ad-label">Advertisement</p>
      <div class="ad-slot" data-format={format}>
        {live ? (
          <ins
            class="adsbygoogle"
            style="display:block;width:100%"
            data-ad-client={ADSENSE_CLIENT}
            data-ad-slot={slot}
            data-ad-format="auto"
            data-full-width-responsive="true"
          />
        ) : (
          <span>{PLACEHOLDER[format]}</span>
        )}
      </div>
    </aside>
  )
}

{
  live && (
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  )
}
