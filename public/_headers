# Cloudflare header rules (read by Workers Static Assets).
#
# Rules are ADDITIVE, not override: when two patterns match the same request,
# both sets of headers are applied and duplicate values get merged into one
# comma-separated header. A `/*` Cache-Control therefore leaks into every more
# specific rule, and browsers honour the most restrictive value they see — which
# silently defeats long-lived asset caching.
#
# So the general rule sets security headers only, and each Cache-Control is
# declared exactly once, on the narrowest pattern that needs it.

/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro fingerprints these with a content hash, so a changed file gets a new
# name and the old one can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate every time. A Budget update has to appear immediately,
# not sit behind a stale page for a year.
/
  Cache-Control: public, max-age=0, must-revalidate

/*/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400
